Project sibang_hankki_unified {
  database_type: 'PostgreSQL'
  Note: '''
    Unified proposal for review, not an executable migration or approved contract.
    Sources: schema.svg / project draft, DB feedback.pdf, CTO sibanghanggi_table.xlsx.
    V1 implements users and restaurants with application-generated UUIDs.
    V2 implements restaurant_images, restaurant_business_hours and restaurant_tags.
    V3 seeds six prototype restaurants and their catalog data; review or replace it
    before production. slotMatrix and availability remain prototype logic, not persisted data.
    Every other table remains a proposal until implemented by a later Flyway migration.

    PROPOSED ONLY: capacity is measured in guests. Each restaurant configures its
    guest capacity and dining duration. Confirmed reservations consume party_size
    across their occupied interval; pending requests hold no capacity. Setting defaults,
    validation bounds, cancellation rules and no-show timing remain unapproved.
    Guest checkout, suspended-account restrictions, consent history, QR redisplay,
    payment providers and extension release scope require confirmation.

    Migration requirements: CHECK positive quantities, nonnegative money/capacity,
    and valid time ranges and status combinations. Normal confirmation cannot exceed
    capacity; an explicit audited restaurant override may do so. Enforce partial
    uniqueness for pending proposals and primary restaurant images.
    Cross-table rules must enforce the same restaurant for slot, reservation, menu,
    category and policy, and the same currency across financial records.
    Audit/history foreign keys use RESTRICT; closing an account never cascades history.
    updated_at must be maintained by the backend or a database trigger.

    All mutation APIs authorize the actor and restaurant scope on every request.
    Unique keys alone are not idempotency: compare actor and request fingerprint,
    lock the reservation before mutation, update state/capacity/event in one transaction.
    A repeated QR scan must be harmless even with a different request key.
    Financial summary writes serialize on the reservation row; refund operations
    also lock the payment and account for pending refunds to avoid over-refunding.
    Payment gateway operations occur outside local DB transactions and require reconciliation.
  '''
}

Enum user_role {
  CUSTOMER
  OWNER
  STAFF
  ADMIN
}

Enum account_status {
  ACTIVE
  SUSPENDED
  CLOSED
}

Enum restaurant_approval_status {
  DRAFT
  PENDING
  CHANGES_REQUESTED
  ACTIVE
  SUSPENDED
}

Enum store_approval_action {
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
  SUSPENDED
  REACTIVATED
}

Enum reservation_status {
  PENDING
  ALTERNATIVE_PROPOSED
  CONFIRMED
  DECLINED
  EXPIRED
  CANCELLED
}

Enum visit_status {
  EXPECTED
  ARRIVED
  SEATED
  COMPLETED
  NO_SHOW
}

Enum proposal_status {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

Enum confirmation_mode {
  AUTO
  MANUAL
  HYBRID
}

Enum reservation_event_type {
  REQUESTED
  CONFIRMED
  DECLINED
  PENDING_EXPIRED
  REOPENED
  ALTERNATIVE_PROPOSED
  ALTERNATIVE_ACCEPTED
  ALTERNATIVE_DECLINED
  ANOTHER_TIME_REQUESTED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_RESTAURANT
  RESCHEDULED
  CHECKED_IN
  SEATED
  COMPLETED
  NO_SHOW
}

Table users {
  id uuid [pk, note: "Generated by the application"]
  userid varchar(30) [not null]
  email varchar(320)
  password_hash varchar(255) [not null, note: "Never store plaintext passwords"]
  name varchar(120) [not null]
  phone varchar(30)
  profile_image text
  role user_role [not null, default: 'CUSTOMER']
  status account_status [not null, default: 'ACTIVE']
  restaurant_id uuid [ref: > restaurants.id]
  status_changed_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    userid
    restaurant_id
  }

  Note: "V1: one role per account. OWNER and STAFF accounts use restaurant_id for store scope; a person working at two restaurants has two accounts. Email is intentionally non-unique and unindexed. userid uniqueness and authentication behavior remain undecided. deleted_at is the soft-delete marker."
}

Table restaurants {
  id uuid [pk, note: "Generated by the application"]
  slug varchar(160) [not null, unique]
  name varchar(200) [not null]
  description text
  cuisine_type varchar(160)
  cuisine_label varchar(160)
  city_slug varchar(160) [not null]
  area varchar(160)
  district varchar(160)
  address text
  phone varchar(30)
  email varchar(320)
  timezone varchar(64) [not null, default: "Asia/Ho_Chi_Minh"]
  price_range varchar(40)
  approval_status restaurant_approval_status [not null, default: 'DRAFT']
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    city_slug
    approval_status
  }
}

Table store_approval_events {
  id uuid [pk, default: `gen_random_uuid()`]
  restaurant_id uuid [not null, ref: > restaurants.id]
  action store_approval_action [not null]
  from_status restaurant_approval_status [not null]
  to_status restaurant_approval_status [not null]
  reason text
  actor_user_id uuid [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (restaurant_id, created_at)
  }

  Note: "Append-only history for submission, approval, requested changes, suspension, and reactivation."
}

Table restaurant_booking_settings {
  restaurant_id uuid [pk, ref: - restaurants.id]
  guest_capacity integer [not null, note: "Restaurant-wide capacity measured in guests"]
  booking_interval_minutes smallint [not null, note: "Spacing between offered start times; not dining duration"]
  dining_duration_minutes smallint [not null, note: "Default occupied duration for a reservation"]
  checkout_hold_minutes smallint [not null, note: "Temporary hold while checkout or payment is in progress"]
  pending_expiry_minutes integer [not null, note: "Maximum time a manually reviewed request may remain pending"]
  confirmation_mode confirmation_mode [not null]
  manual_confirmation_min_party_size smallint [note: "Required only in HYBRID mode; requests at or above this size require manual review"]
  booking_window_days smallint [not null, default: 60]
  minimum_party_size smallint [not null, default: 1]
  maximum_online_party_size smallint [not null, default: 6]
  large_party_threshold smallint [not null, default: 10]
  customer_cancellation_cutoff_minutes integer [note: "Unconfigured until approved; zero may be valid"]
  no_show_grace_minutes integer [note: "Unconfigured until approved; zero may be valid"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: "Capacity and time settings are restaurant-specific. Positive capacity, interval, duration, hold, expiry and party limits. HYBRID requires a positive manual threshold; other modes leave it empty. Exact defaults and validation bounds remain to be approved."
}

Table restaurant_business_hours {
  id uuid [pk, note: "Generated by the application"]
  restaurant_id uuid [not null, ref: > restaurants.id]
  day_of_week smallint [not null, note: "ISO day: 1 Monday through 7 Sunday"]
  opens_at time [not null]
  closes_at time [not null]

  indexes {
    (restaurant_id, day_of_week, opens_at) [unique]
    (restaurant_id, day_of_week)
  }

  Note: "Implemented in V2. Multiple rows per day support split service periods. No row means closed. CHECK day_of_week between 1 and 7 and opens_at < closes_at. V2 has no audit or soft-delete columns."
}

Table restaurant_schedule_exceptions {
  id uuid [pk, default: `gen_random_uuid()`]
  restaurant_id uuid [not null, ref: > restaurants.id]
  service_date date [not null]
  is_closed boolean [not null, default: false]
  opens_at time
  closes_at time
  reason varchar(255)
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (restaurant_id, service_date) [unique]
  }

  Note: "Overrides normal hours for holidays, closures, or special service times. Closed rows leave opening and closing times empty."
}

Table booking_slots {
  id uuid [pk, default: `gen_random_uuid()`]
  restaurant_id uuid [not null, ref: > restaurants.id]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  capacity_total integer [not null, default: 0, note: "Guest capacity for this interval, initialized from restaurant settings or an explicit override"]
  capacity_reserved integer [not null, default: 0, note: "Sum of party_size for confirmed reservations occupying this interval; may exceed capacity_total only through an explicit audited override"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (restaurant_id, starts_at) [unique]
  }

  Note: "PROPOSED: guest-count inventory; pending requests hold none. ends_at > starts_at. A confirmed reservation consumes party_size in every affected interval. Lock affected slot rows in consistent order during confirmation, cancellation and rescheduling."
}

Table reservations {
  id uuid [pk, default: `gen_random_uuid()`]
  reference varchar(32) [not null, unique]
  idempotency_key varchar(255) [not null, unique]
  request_fingerprint varchar(64) [not null, note: "Hash canonical creation payload; mismatching retries are rejected after authorization"]
  restaurant_id uuid [not null, ref: > restaurants.id]
  booking_slot_id uuid [ref: > booking_slots.id, note: "Nullable for manual or large-party requests"]
  customer_id uuid [ref: > users.id, note: "Nullable if guest checkout is supported"]
  customer_name varchar(120) [not null]
  customer_email varchar(320)
  customer_phone varchar(30) [not null]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null, note: "Snapshot calculated from the restaurant dining duration when booked or rescheduled"]
  party_size integer [not null, note: "Must be greater than zero"]
  status reservation_status [not null, default: 'PENDING']
  capacity_override boolean [not null, default: false, note: "True only when an authorized restaurant member explicitly confirms beyond available capacity; actor and context belong in reservation_events"]
  visit_status visit_status
  special_request text
  pre_order_note text
  check_in_token_hash varchar(255) [unique, note: "Hash only. Delivery/redisplay is unresolved: hash cannot reconstruct raw token; authorized reissue rotates it"]
  checked_in_at timestamptz
  checked_in_by uuid [ref: > users.id]
  currency char(3) [note: "Financial extension: required when priced, no implicit KRW default"]
  subtotal numeric(18,2)
  discount_amount numeric(18,2)
  total_amount numeric(18,2)
  discount_policy_id uuid [ref: > discount_policies.id]
  refund_policy_id uuid [ref: > refund_policies.id]
  pricing_policy_snapshot jsonb [note: "Immutable applied terms; changing a policy must not rewrite an existing booking"]
  payment_status payment_summary_status [not null, default: 'NOT_REQUIRED']
  paid_amount_total numeric(18,2) [not null, default: 0]
  refunded_amount_total numeric(18,2) [not null, default: 0]
  last_refunded_at timestamptz
  version integer [not null, default: 0, note: "Optimistic locking"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (restaurant_id, starts_at)
    (restaurant_id, status)
    (customer_id, created_at)
  }

  Note: "Decision, visit and payment states are separate. Financial fields are Extension scope; payment/refund totals are rebuildable summaries of successful transactions. Nonconfirmed reservations have no visit status; confirmed reservations have a visit status. Cancel only before arrival under approved policy and clear EXPECTED, preserving events. Validate slot restaurant/time. Owner rescheduling rechecks capacity and preserves previous values in reservation_events."
}

Table reservation_proposals {
  id uuid [pk, default: `gen_random_uuid()`]
  reservation_id uuid [not null, ref: > reservations.id]
  proposed_booking_slot_id uuid [ref: > booking_slots.id, note: "Nullable for manual or large-party proposals"]
  proposed_starts_at timestamptz [not null]
  proposed_party_size integer [not null, note: "Positive snapshot, equal to current party size for time-only proposals; change support pending approval"]
  reservation_version integer [not null, note: "Expected reservation version; reject stale acceptance"]
  message text
  respond_by timestamptz
  status proposal_status [not null, default: 'PENDING']
  created_by uuid [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  responded_by uuid [ref: > users.id]
  responded_at timestamptz

  indexes {
    (reservation_id, created_at)
    (reservation_id, status)
  }

  Note: "SQL partial UNIQUE reservation_id WHERE status=PENDING. A confirmed booking stays CONFIRMED while a change is pending. Accept atomically with old/new slot updates; reject expired/stale proposals and preserve original booking on failure. Same-slot changes must not consume an extra unit. Close pending proposals on cancellation. Decline/expiry of a change leaves confirmed bookings intact."
}

Table reservation_events {
  id uuid [pk, default: `gen_random_uuid()`]
  reservation_id uuid [not null, ref: > reservations.id]
  event_type reservation_event_type [not null]
  actor_user_id uuid [ref: > users.id, note: "Nullable for system-generated events"]
  command_id varchar(255) [unique]
  request_fingerprint varchar(64) [note: "Compare actor and canonical payload when replaying a command"]
  metadata jsonb
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (reservation_id, created_at)
  }

  Note: "Append-only audit trail. JSONB contains event-specific context, not primary business state. Actor and created_at record who performed each transition and when."
}

Enum payment_summary_status {
  NOT_REQUIRED
  UNPAID
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}
Enum transaction_status {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}
Enum consent_type {
  TERMS
  PRIVACY
  MARKETING
}

Enum inquiry_status {
  pending
  in_progress
  completed
  rejected
}

Enum discount_type {
  percentage
  fixed
}

Enum notification_status {
  sent
  failed
  pending
}

Enum meal_type {
  breakfast
  lunch
  dinner
}

Table user_consents {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  type consent_type [not null]
  document_version varchar(80) [not null]
  granted boolean [not null]
  recorded_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, type, recorded_at)
  }
  Note: "Proposed consent history replacing duplicated profile in users_ref. Record withdrawal as a new event. Requirements and document version policy await confirmation."
}

// Implemented in V2.
Table restaurant_images {
  id uuid [pk, note: "Generated by the application"]
  restaurant_id uuid [not null, ref: > restaurants.id]
  image_url text [not null]
  alt_text text
  sort_order integer [not null, default: 0]
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    restaurant_id [note: "SQL migration uses a partial index WHERE deleted_at IS NULL"]
  }

  Note: "Implemented in V2. CHECK sort_order >= 0. galleryCount is derived from active image rows; no primary-image flag exists in V2."
}

// Implemented in V2.
Table restaurant_tags {
  id uuid [pk, note: "Generated by the application"]
  restaurant_id uuid [not null, ref: > restaurants.id]
  tag varchar(30) [not null, note: "Allowed: michelin, special_deal, date_night"]
  show_in_benefits boolean [not null, default: false]

  indexes {
    (restaurant_id, tag) [unique]
    restaurant_id
  }

  Note: "Implemented in V2. Availability is derived and is not stored as a tag. V2 has no audit or soft-delete columns."
}

// Extension: release scope requires confirmation.
Table restaurant_features {
  id uuid [pk, default: `gen_random_uuid()`]
  restaurant_id uuid [not null, unique]
  has_parking boolean [default: false]
  has_wifi boolean [default: false]
  accepts_reservations boolean [default: true]
  offers_delivery boolean [default: false]
  created_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_by uuid [ref: > users.id]
  updated_at timestamptz [not null, default: `now()`]

  Note: "One feature row per restaurant."
}

// Extension: release scope requires confirmation.
Table menu_categories {
  id uuid [pk, default: `gen_random_uuid()`]
  restaurant_id uuid [not null]
  name varchar(50) [not null]
  display_order int [default: 0]
  created_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_by uuid [ref: > users.id]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    restaurant_id
  }
}

// Extension: release scope requires confirmation.
Table menus {
  id uuid [pk, default: `gen_random_uuid()`]
  restaurant_id uuid [not null]
  category_id uuid
  name varchar(100) [not null]
  description text
  price numeric(18,2) [not null]
  currency char(3) [not null]
  image_url varchar(255)
  is_available boolean [default: true]
  created_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_by uuid [ref: > users.id]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    restaurant_id
    category_id
  }

  Note: "Menu master data."
}

// Extension: release scope requires confirmation.
Table reservation_menu_items {
  id uuid [pk, default: `gen_random_uuid()`]
  reservation_id uuid [not null]
  menu_id uuid
  menu_name_snapshot varchar(100) [not null]
  quantity int [not null]
  unit_price_snapshot numeric(18,2) [not null]
  created_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_by uuid [ref: > users.id]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    reservation_id
    menu_id
  }

  Note: "Extension: immutable name/price snapshots, positive quantity and nonnegative unit price. Currency inherited from reservation. Menu must belong to the reservation restaurant."
}

// Extension: release scope requires confirmation.
Table payments {
  id uuid [pk, default: `gen_random_uuid()`]
  reservation_id uuid [not null]
  user_id uuid
  payment_method varchar(50) [not null]
  amount numeric(18,2) [not null]
  currency char(3) [not null]
  status transaction_status [not null, default: 'PENDING']
  transaction_id varchar(100)
  payment_gateway varchar(50)
  payment_data jsonb
  idempotency_key varchar(255) [not null, unique]
  request_fingerprint varchar(64) [not null]
  completed_at timestamptz
  created_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_by uuid [ref: > users.id]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    reservation_id
    (payment_gateway, transaction_id) [unique]
    user_id
  }

  Note: "Extension: each row is a payment attempt. Nonnegative monetary values, matching reservation currency, immutable successful transactions. Scope gateway IDs to the configured provider account. Never store card secrets in payment_data."
}

// Extension: release scope requires confirmation.
Table refunds {
  id uuid [pk, default: `gen_random_uuid()`]
  payment_id uuid [not null]
  amount numeric(18,2) [not null, default: 0]
  currency char(3) [not null]
  idempotency_key varchar(255) [not null, unique]
  request_fingerprint varchar(64) [not null]
  gateway_refund_id varchar(100)
  reason text
  status transaction_status [not null, default: 'PENDING']
  refund_method varchar(50)
  refund_details text
  processed_by uuid [note: "User who initiated processing; nullable for automated processing"]
  processed_at timestamptz
  created_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_by uuid [ref: > users.id]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    payment_id
  }

  Note: "Extension: reservation is obtained through payment_id. Positive amount, payment currency required. Lock payment and reservation, count pending plus successful refunds against paid amount. Deduplicate gateway callbacks; rebuild reservation summary under lock."
}

// Extension: release scope requires confirmation.
Table discount_policies {
  id uuid [pk, default: `gen_random_uuid()`]
  restaurant_id uuid [not null]
  name varchar(100) [not null]
  description text
  discount_type discount_type [not null]
  discount_value numeric(18,2) [not null]
  currency char(3) [note: "Required for fixed discounts or monetary thresholds"]
  min_order_amount numeric(18,2)
  max_discount_amount numeric(18,2)
  start_date date
  end_date date
  is_active boolean [default: true]
  hours_before_booking numeric(18,2) [note: "Hours before the booking when the policy applies"]
  created_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_by uuid [ref: > users.id]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    restaurant_id
  }

  Note: "Restaurant discount policies."
}

// Extension: release scope requires confirmation.
Table refund_policies {
  id uuid [pk, default: `gen_random_uuid()`]
  restaurant_id uuid [not null]
  name varchar(100) [not null]
  description text
  hours_before_booking numeric(18,2) [not null, note: "Hours before booking when the policy applies"]
  refund_percentage int [not null, note: "Refund percentage"]
  is_active boolean [default: true]
  created_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_by uuid [ref: > users.id]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    restaurant_id
  }
}

// Extension: release scope requires confirmation.
Table favorites {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  restaurant_id uuid [not null]
  created_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_by uuid [ref: > users.id]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    restaurant_id
    (user_id, restaurant_id) [unique, name: 'unique_user_restaurant']
  }

  Note: "Restaurants favorited by users."
}

// Extension: release scope requires confirmation.
Table reviews {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid
  restaurant_id uuid [not null]
  reservation_id uuid
  rating int [not null, note: "Approved rating scale enforced with CHECK; linked reservation must match restaurant/customer"]
  comment text
  is_hidden boolean [default: false, note: "Hidden by an administrator"]
  is_reported boolean [default: false]
  created_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_by uuid [ref: > users.id]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    restaurant_id
    reservation_id
  }
}

// Extension: release scope requires confirmation.
Table review_images {
  id uuid [pk, default: `gen_random_uuid()`]
  review_id uuid [not null]
  image_url varchar(255) [not null]
  created_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_by uuid [ref: > users.id]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    review_id
  }
}

// Extension: release scope requires confirmation.
Table contact_inquiries {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  name varchar(100) [not null]
  email varchar(255) [not null]
  phone varchar(20)
  subject varchar(255) [not null]
  message text [not null]
  attachment_url varchar(255)
  status inquiry_status [not null, default: 'pending']
  created_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_by uuid [ref: > users.id]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    status
  }

  Note: "Customer inquiry information."
}

// Extension: release scope requires confirmation.
Table contact_responses {
  id uuid [pk, default: `gen_random_uuid()`]
  inquiry_id uuid [not null]
  admin_id uuid [not null]
  response_text text [not null]
  created_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_by uuid [ref: > users.id]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    inquiry_id
  }

  Note: "Responses to customer inquiries."
}

// Extension: release scope requires confirmation.
Table banners {
  id uuid [pk, default: `gen_random_uuid()`]
  title varchar(255) [not null]
  image_url varchar(255) [not null]
  link_url varchar(255) [not null]
  is_active boolean [default: true]
  start_date date [not null]
  end_date date [not null]
  created_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_by uuid [ref: > users.id]
  updated_at timestamptz [not null, default: `now()`]

  Note: "Banner information."
}

// Extension: release scope requires confirmation.
Table notification_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  reservation_id uuid [not null]
  user_id uuid
  notification_type varchar(50) [not null]
  status notification_status [not null]
  error_message text
  sent_at timestamptz [note: "Null until delivery succeeds"]
  created_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_by uuid [ref: > users.id]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    reservation_id
    user_id
    sent_at
  }
}

// Extension: release scope requires confirmation.
Table weekly_menus {
  id uuid [pk, default: `gen_random_uuid()`]
  restaurant_id uuid [not null]
  week_start_date date [not null, note: "Monday of the corresponding week"]
  meal_date date [not null]
  meal_type meal_type [not null, default: 'lunch']
  meal_name varchar(255) [not null]
  main_dish varchar(255) [not null]
  side_dishes jsonb
  soup varchar(255)
  calories int
  created_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_by uuid [ref: > users.id]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (restaurant_id, meal_date) [name: 'idx_restaurant_date']
    (restaurant_id, week_start_date) [name: 'idx_restaurant_week']
    (meal_date, meal_type) [name: 'idx_date_meal']
    (restaurant_id, meal_date, meal_type) [unique, name: 'unique_restaurant_date_meal']
  }

  Note: "Weekly meal information."
}

Ref: reservation_menu_items.reservation_id > reservations.id
Ref: reservation_menu_items.menu_id > menus.id
Ref: contact_inquiries.user_id > users.id
Ref: contact_responses.inquiry_id > contact_inquiries.id
Ref: contact_responses.admin_id > users.id
Ref: discount_policies.restaurant_id > restaurants.id
Ref: favorites.user_id > users.id
Ref: favorites.restaurant_id > restaurants.id
Ref: menu_categories.restaurant_id > restaurants.id
Ref: menus.restaurant_id > restaurants.id
Ref: menus.category_id > menu_categories.id
Ref: notification_logs.reservation_id > reservations.id
Ref: payments.reservation_id > reservations.id
Ref: payments.user_id > users.id
Ref: refund_policies.restaurant_id > restaurants.id
Ref: refunds.payment_id > payments.id
Ref: refunds.processed_by > users.id
Ref: restaurant_features.restaurant_id - restaurants.id
Ref: review_images.review_id > reviews.id
Ref: reviews.user_id > users.id
Ref: reviews.restaurant_id > restaurants.id
Ref: reviews.reservation_id > reservations.id
Ref: weekly_menus.restaurant_id > restaurants.id
Ref: notification_logs.user_id > users.id

TableGroup CoreIdentity {
  users
  user_consents
}

TableGroup CoreRestaurant {
  restaurants
  restaurant_images
  restaurant_tags
  store_approval_events
}

TableGroup CoreSchedule {
  restaurant_booking_settings
  restaurant_business_hours
  restaurant_schedule_exceptions
}

TableGroup CoreReservation {
  booking_slots
  reservations
  reservation_proposals
  reservation_events
}

TableGroup ExtensionRestaurantContent {
  restaurant_features
  menus
  menu_categories
  reservation_menu_items
  weekly_menus
}

TableGroup ExtensionFinance {
  payments
  refunds
  discount_policies
  refund_policies
}

TableGroup ExtensionEngagement {
  favorites
  reviews
  review_images
}

TableGroup ExtensionSupportMarketing {
  contact_inquiries
  contact_responses
  notification_logs
  banners
}
